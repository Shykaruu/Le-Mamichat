# Politique de cache du journal.
#
# Le HTML porte les noms empreintes des fichiers CSS et JS. S'il est mis en
# cache, un lecteur peut se retrouver avec un index.html perime qui reclame
# une feuille de style qui n'existe plus : 404, page sans style, fond beige nu.
# Le HTML doit donc etre revalide a chaque visite.
#
# A l'inverse, les fichiers CSS et JS changent de nom a chaque publication :
# ils peuvent etre gardes un an sans risque.
#
# Les images et la video, elles, gardent leur nom d'une version a l'autre --
# une journee de cache, pour qu'une photo remplacee apparaisse vite.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
